datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id               String  @id @default(cuid())
  title            String
  category         String
  date             String
  time             String  @default("09:00 AM")
  venue            String
  address          String  @default("Langley, Slough, United Kingdom")
  ticketPrice      Int     @default(0) // Adult ticket price (£)
  childTicketPrice Int     @default(0) // Child ticket price (£)
  status           String  @default("Upcoming")
  description      String
  bannerUrl        String
  capacity         Int     @default(300)
  rsvpCount        Int     @default(0)
  featured         Boolean @default(false)

  // Customization Toggles:
  enableRsvp           Boolean @default(true)
  enableSupportPayment Boolean @default(true)
  enablePooja          Boolean @default(true)

  // Capacity Limit enforcement & alerts:
  enforceCapacityLimit Boolean  @default(false)
  capacityAlertSent    Boolean  @default(false)
  adultCapacity        Int?     @default(0) // 0 = no separate limit (bounded by total capacity)
  childCapacity        Int?     @default(0) // 0 = no separate limit (bounded by total capacity)
  availableDates       String[] @default([])
  eventSchedule        Json?    @default("[]")

  // Venue Map & Custom Form Fields:
  mapUrl       String?
  customFields Json?   @default("[]")

  rsvps      EventRSVP[]
  mediaItems MediaItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model EventRSVP {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendeeName   String
  attendeeEmail  String
  attendeePhone  String
  travellingFrom String?
  ticketsCount   Int      @default(1)
  adultsCount    Int      @default(1)
  childrenCount  Int      @default(0)
  selectedDates  String[] @default([])

  // Payment tracking for paid RSVPs & Event Support:
  totalAmount     Float   @default(0)
  supportAmount   Float   @default(0)
  paymentStatus   String  @default("Free") // "Free" | "Pending" | "Completed"
  paymentIntentId String?

  // Dynamic Custom Field Responses:
  customResponses Json? @default("{}")

  createdAt DateTime @default(now())
}

model Sponsor {
  id          String   @id @default(cuid())
  name        String
  tier        String   @default("Partner")
  logoUrl     String
  websiteUrl  String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  accent      String?  @default("from-[#E65C00] to-[#FF7A00]")
  gradient    String?  @default("linear-gradient(135deg, #E65C00 0%, #FF7A00 100%)")
  blackLogoBg Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id                String   @id @default("default-settings")
  siteTitle         String   @default("Mana Indian Telugu Roots Abroad (MITRA)")
  tagline           String   @default("Serving and Connecting the Telugu Community in the United Kingdom")
  contactEmail      String   @default("info@mitra.org.uk")
  contactPhone      String   @default("+44 20 8123 4567")
  address           String   @default("MITRA Centre, Chiswick Park, 566 Chiswick High Rd, London W4 5YA, United Kingdom")
  twitterUrl        String   @default("https://twitter.com/mitra_official")
  linkedinUrl       String   @default("https://linkedin.com/company/mitra-official")
  facebookUrl       String   @default("https://facebook.com/ukteluguassociation")
  instagramUrl      String   @default("https://instagram.com/mitra_official")
  youtubeUrl        String   @default("https://youtube.com/@mitraofficial")
  googleAnalyticsId String   @default("G-MITRA2026SEO")
  enableTracking    Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Member {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String
  tier         String   @default("Annual Member")
  role         String   @default("Member")
  status       String   @default("Active")
  profession   String?
  address      String?
  passwordHash String?
  startDate    String?
  expiryDate   String?
  notes        String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CharityCase {
  id            String   @id @default(cuid())
  applicantName String
  category      String   @default("Student Care")
  urgency       String   @default("Medium")
  status        String   @default("Open")
  description   String
  contactPhone  String
  contactEmail  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  phone     String?
  source    String   @default("Live Reveal")
  createdAt DateTime @default(now())
}

model MediaItem {
  id                String   @id @default(cuid())
  title             String
  type              String   @default("IMAGE") // "IMAGE" or "VIDEO"
  category          String   @default("Photo")
  coverImage        String?
  url               String   @default("")
  description       String?
  eventId           String?
  event             Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  isFeatured        Boolean  @default(false)
  displayOrder      Int      @default(0)
  isHomeFeatured    Boolean  @default(false)
  homeDisplayOrder  Int      @default(0)
  isEventFeatured   Boolean  @default(false)
  eventDisplayOrder Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([eventId])
  @@index([type])
  @@index([isHomeFeatured])
  @@index([isEventFeatured])
}

model BlogPost {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String
  content    String
  category   String
  author     String   @default("MITRA Editorial")
  date       String
  coverImage String
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payment {
  id                    String  @id @default(cuid())
  amount                Float
  currency              String  @default("GBP")
  status                String  @default("Completed") // "Completed", "Pending", "Failed"
  customerName          String
  customerEmail         String
  customerPhone         String?
  description           String // "Donation to Student Fund", "Mahotsav VIP Ticket", etc.
  paymentMethod         String  @default("Stripe Card")
  stripePaymentIntentId String?
  memberId              String? // Plain standalone string identifier (no foreign key constraint)

  // ── Event & Donation Classification (flexible string, no enum) ─────────
  eventId      String? // e.g. "evt-ganesh-chaturthi"
  eventName    String? // e.g. "London Ganesh Mahotsav 2026"
  donationType String? // e.g. "pooja", "anadanam", "event donation", "membership", "general"

  // ── Sacred Pooja & Devotee Sankalpam Details ───────────────────────────
  poojaCategory      String? // e.g. "Maha Yajaman", "Vishita Yajaman", "Yajaman", "7 Days Daily Archana"
  poojaDate          String? // e.g. "13th Sep"
  poojaDay           String? // e.g. "Sunday"
  poojaTitle         String? // e.g. "Ganapathi Agamana"
  gotram             String? // e.g. "Kasyapa"
  familyMembers      String? // e.g. "Priya (Rohini), Aryan (Revathi)"
  specialWishes      String? // Special prayer / wish notes
  primaryDevoteeName String? // Yajamani name

  createdAt DateTime @default(now())
  // updatedAt          DateTime @updatedAt
}

model PaymentSettings {
  id                   String   @id @default("default")
  stripePublishableKey String
  stripeSecretKey      String
  currency             String   @default("GBP")
  activeAccountName    String   @default("MITRA Main Account")
  updatedAt            DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("Admin")
  createdAt    DateTime @default(now())
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String // "REGISTER" or "FORGOT_PASSWORD"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model LeadershipMember {
  id           String   @id @default(cuid())
  name         String
  designation  String
  category     String   @default("Executive Committee") // Founders, Patrons, Trustees, Executive Committee, Nari Shakthi
  bio          String?
  imageUrl     String   @default("/assets/poster.jpg")
  email        String?
  phone        String?
  linkedin     String?
  twitter      String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // INFO, WARN, ERROR, PAYMENT_SUCCESS, PAYMENT_FAILURE
  source    String // e.g. "payments/webhook", "payments/create-session", "auth", "system"
  message   String
  details   Json? // Structured metadata, stack traces, payment details
  ip        String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([source])
}

model TeluguBusiness {
  id           String   @id @default(cuid())
  businessName String
  ownerName    String
  category     String   @default("IT & Software Services")
  tagline      String?
  description  String
  logoUrl      String?
  coverUrl     String?
  email        String
  phone        String
  whatsapp     String?
  website      String?
  address      String?
  city         String   @default("London")
  postcode     String?
  status       String   @default("Pending") // "Pending", "Approved", "Rejected"
  isFeatured   Boolean  @default(false)
  specialOffer String? // e.g. "10% off for MITRA members"
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([city])
}

model EmailQueue {
  id           String   @id @default(cuid())
  email        String
  subject      String
  html         String
  status       String   @default("pending") // pending, failed -> send will be deleted
  tryCount     Int      @default(0)
  campaignType String?
  campaignId   String?
  createdAt    DateTime @default(now())
}
