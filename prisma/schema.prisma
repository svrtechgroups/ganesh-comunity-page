datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id          String      @id @default(cuid())
  title       String
  category    String
  date        String
  time        String      @default("09:00 AM")
  venue       String
  address     String      @default("Langley, Slough, United Kingdom")
  ticketPrice Int         @default(0)
  status      String      @default("Upcoming")
  description String
  bannerUrl   String
  capacity    Int         @default(300)
  rsvpCount   Int         @default(0)
  featured    Boolean     @default(false)
  rsvps       EventRSVP[]
  mediaItems  MediaItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model EventRSVP {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendeeName   String
  attendeeEmail  String
  attendeePhone  String
  travellingFrom String?
  ticketsCount   Int      @default(1)
  adultsCount    Int      @default(1)
  childrenCount  Int      @default(0)
  selectedDates  String[] @default([])
  createdAt      DateTime @default(now())
}

model Sponsor {
  id         String   @id @default(cuid())
  name       String
  tier       String   @default("Partner")
  logoUrl    String
  websiteUrl String?
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Member {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  phone        String
  tier         String    @default("Annual Member")
  role         String    @default("Member")
  status       String    @default("Active")
  profession   String?
  address      String?
  passwordHash String?
  startDate    String?
  expiryDate   String?
  notes        String?
  imageUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CharityCase {
  id            String   @id @default(cuid())
  applicantName String
  category      String   @default("Student Care")
  urgency       String   @default("Medium")
  status        String   @default("Open")
  description   String
  contactPhone  String
  contactEmail  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  phone     String?
  source    String   @default("Live Reveal")
  createdAt DateTime @default(now())
}

model MediaItem {
  id           String    @id @default(cuid())
  title        String
  type         String    @default("IMAGE") // "IMAGE" or "VIDEO"
  category     String    @default("Photo")
  coverImage   String?
  url          String    @default("")
  description  String?
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  isFeatured   Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([eventId])
  @@index([type])
}

model BlogPost {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String
  content    String
  category   String
  author     String   @default("MITRA Editorial")
  date       String
  coverImage String
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payment {
  id                    String   @id @default(cuid())
  amount                Float
  currency              String   @default("GBP")
  status                String   @default("Completed") // "Completed", "Pending", "Failed"
  customerName          String
  customerEmail         String
  customerPhone         String?
  description           String   // "Donation to Student Fund", "Mahotsav VIP Ticket", etc.
  paymentMethod         String   @default("Stripe Card")
  stripePaymentIntentId String?
  memberId              String?  // Plain standalone string identifier (no foreign key constraint)

  // ── Event & Donation Classification (flexible string, no enum) ─────────
  eventId               String?  // e.g. "evt-ganesh-chaturthi"
  eventName             String?  // e.g. "London Ganesh Mahotsav 2026"
  donationType          String?  // e.g. "pooja", "anadanam", "event donation", "membership", "general"

  // ── Sacred Pooja & Devotee Sankalpam Details ───────────────────────────
  poojaCategory         String?  // e.g. "Maha Yajaman", "Vishita Yajaman", "Yajaman", "7 Days Daily Archana"
  poojaDate             String?  // e.g. "13th Sep"
  poojaDay              String?  // e.g. "Sunday"
  poojaTitle            String?  // e.g. "Ganapathi Agamana"
  gotram                String?  // e.g. "Kasyapa"
  familyMembers         String?  // e.g. "Priya (Rohini), Aryan (Revathi)"
  specialWishes         String?  // Special prayer / wish notes
  primaryDevoteeName    String?  // Yajamani name

  createdAt             DateTime @default(now())
  // updatedAt          DateTime @updatedAt
}

model PaymentSettings {
  id                    String   @id @default("default")
  stripePublishableKey  String
  stripeSecretKey       String
  currency              String   @default("GBP")
  activeAccountName     String   @default("MITRA Main Account")
  updatedAt             DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("Admin")
  createdAt    DateTime @default(now())
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   // "REGISTER" or "FORGOT_PASSWORD"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model LeadershipMember {
  id           String   @id @default(cuid())
  name         String
  designation  String
  category     String   @default("Executive Committee") // Founders, Patrons, Trustees, Executive Committee, Nari Shakthi
  bio          String?
  imageUrl     String   @default("/assets/poster.jpg")
  email        String?
  phone        String?
  linkedin     String?
  twitter      String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // INFO, WARN, ERROR, PAYMENT_SUCCESS, PAYMENT_FAILURE
  source    String   // e.g. "payments/webhook", "payments/create-session", "auth", "system"
  message   String
  details   Json?    // Structured metadata, stack traces, payment details
  ip        String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([source])
}

model TeluguBusiness {
  id           String   @id @default(cuid())
  businessName String
  ownerName    String
  category     String   @default("IT & Software Services")
  tagline      String?
  description  String
  logoUrl      String?
  coverUrl     String?
  email        String
  phone        String
  whatsapp     String?
  website      String?
  address      String?
  city         String   @default("London")
  postcode     String?
  status       String   @default("Pending") // "Pending", "Approved", "Rejected"
  isFeatured   Boolean  @default(false)
  specialOffer String?  // e.g. "10% off for MITRA members"
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([city])
}

